# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/studentms

# JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port
PORT=5000

# URLs
FRONTEND_URL=http://127.0.0.1:8080
BACKEND_URL=http://localhost:5000

# Brevo (Sendinblue) SMTP Mail Configuration
# Get your SMTP Key from Brevo -> Transactional -> SMTP & API
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Student Mind Support
